{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"resolveJsonModule": true,
		"types": ["node"]
	},
	"include": ["**/*.ts"],
	"exclude": [
		"node_modules",
		".tmp",
		"videos",
		"test-results",
		"playwright-report"
	]
}
